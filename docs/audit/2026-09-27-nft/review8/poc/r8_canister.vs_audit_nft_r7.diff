+fn one_shallow(mixed: bool, depth: u64, passes: usize) -> (usize, usize, ef::SaleScan, u32) {
+    let mut f = Fake::new(false);
+    let mut st = EthState::default();
+    f.finalized = ETH_PIN;
+    f.pin_now = Some(ETH_PIN);
+    f.m(MODULE).accepted = 93 * E / 100;
+    f.log_depth = Some(depth);
+    f.mixed_depth = mixed;
+    let top0 = ETH_PIN - en::SALE_FINAL_DEPTH_BLOCKS;
+    let old = newer_sales(&mut f, top0 - en::SALE_WINDOW_BLOCKS + 3_000, 400, 100, 0x6a);
+    let mut pin = ETH_PIN;
+    for _ in 0..passes {
+        pin += 100;
+        f.pin_now = Some(pin);
+        f.finalized = pin;
+        quiet(&mut f, &mut st);
+    }
+    let top = pin - en::SALE_FINAL_DEPTH_BLOCKS;
+    let bottom = top - en::SALE_WINDOW_BLOCKS;
+    let deep: Vec<[u8; 32]> = old.iter().filter(|x| x.1 >= bottom && x.1 + depth < pin).map(|x| x.0).collect();
+    (cached(&st, &deep), deep.len(), scan_of(&st), f.log_fails)
+}
