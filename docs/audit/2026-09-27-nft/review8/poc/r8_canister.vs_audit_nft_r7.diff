+#[test]
+fn r8_b_one_genuinely_shallow_provider_is_no_longer_paged() {
+    for (mixed, what) in [(false, "BOTH providers shallow (deep)"), (true, "ONE provider shallow, the other serves (mixed)")] {
+        let (got, all, sc, fails) = one_shallow(mixed, 20_000, 144);
+        println!("{what}: down {} up {} skipped {:?} raw {:?} stuck {:?}", sc.down, sc.up, sc.skipped.as_ref().map(|v| v.len()), sc.raw, sc.stuck);
+        println!("{what}: sales deeper than 20,000 blocks counted {got} of {all}; lost {:?}; hole {:?}; hole_deep {:?}; behind {:?}; busy {:?}; rbusy {:?}; bad {:?}; log fails {fails}",
+            sc.lost, sc.hole, sc.hole_deep, sc.behind, sc.busy, sc.rbusy.as_ref().map(|v| v.len()), sc.bad.as_ref().map(|v| v.len()));
+    }
+}
