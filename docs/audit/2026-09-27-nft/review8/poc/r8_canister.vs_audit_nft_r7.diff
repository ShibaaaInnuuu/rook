+// ===== review round 8 PoCs (private copy only) =====
+#[test]
+fn r8_c_a_batched_request_paying_two_of_our_orders_credits_only_one() {
+    // one depository execute whose request pays us twice (two written-off 5 ETH orders refunded in one batch)
+    let (w, o) = written_off_order();
+    let ob = ef::LateOrder { watch: ef::Watch { order_id: [0x0e; 32], ..w.clone() }, ..o.clone() };
+    let (input, logs) = relay_execute(&[(US, 49 * E / 10), (US, 48 * E / 10)], [0x8b; 32]);
+    let t = ef::PayoutTx { from: SOLVER, to: rc::RELAY_DEPOSITORY_4663, value: 0, input, block: 70_000_001, success: true };
+    let tx = [0x01; 32];
+    let a = ef::judge_payout(&o, &t, &logs, &tx, true, &US, 49 * E / 10, &[]);
+    let b = ef::judge_payout(&ob, &t, &logs, &tx, true, &US, 48 * E / 10, &[tx]);
+    println!("order A: {a:?}; order B, same tx after A: {b:?}");
+    assert_eq!(a, Ok(49 * E / 10));
+    assert!(b.unwrap_err().contains("credited already"), "the second refund of the batch can never be credited");
+}
+
+#[test]
+fn r8_c_b_spoofs_refused() {
+    let (w, o) = written_off_order();
+    let refund = 49 * E / 10;
+    // (1) a crafted request in the input (paying us), while the receipt's record is a DIFFERENT request paying us (nested execute)
+    let (crafted_in, _) = relay_execute(&[(US, refund)], [0x99; 32]);
+    let (_, real_logs) = relay_execute(&[(US, refund)], [0x8b; 32]);
+    let t = ef::PayoutTx { from: ATTACKER, to: rc::RELAY_DEPOSITORY_4663, value: 0, input: crafted_in, block: 70_000_001, success: true };
+    let r1 = ef::judge_payout(&o, &t, &real_logs, &[0x02; 32], true, &US, refund, &[]);
+    // (2) the record's id right, but the call paying ANOTHER address with our order id in its data
+    let r = rc::CallRequest { calls: vec![rc::DepCall { to: ATTACKER, data: w.order_id.to_vec(), value: refund, allow_failure: false }],
+        nonce: [0x8b; 32], expiration: [0u8; 32] };
+    let inp = rc::encode_execute(&r, &[0x11; 65]);
+    let id = rc::call_request_hash(&r);
+    let t2 = ef::PayoutTx { input: inp, ..t.clone() };
+    let r2 = ef::judge_payout(&o, &t2, &[relay_exec(id, ATTACKER, refund)], &[0x03; 32], true, &US, 0, &[]);
+    // (3) amount collision: two records paying us the same amount: one credited at that amount, never the sum
+    let (in3, logs3) = relay_execute(&[(US, refund), (US, refund)], [0x8b; 32]);
+    let r3 = ef::judge_payout(&o, &ef::PayoutTx { input: in3, ..t.clone() }, &logs3, &[0x04; 32], true, &US, refund, &[]);
+    // (4) a zero-value record paying us beside a stated amount
+    let (in4, logs4) = relay_execute(&[(US, 0)], [0x8b; 32]);
+    let r4 = ef::judge_payout(&o, &ef::PayoutTx { input: in4, ..t.clone() }, &logs4, &[0x05; 32], true, &US, refund, &[]);
+    // (5) a record with a truncated/odd flag word in the input: no decode, no credit
+    let (mut in5, logs5) = relay_execute(&[(US, refund)], [0x8b; 32]);
+    let n = in5.len(); in5.truncate(n - 70);
+    let r5 = ef::judge_payout(&o, &ef::PayoutTx { input: in5, ..t.clone() }, &logs5, &[0x06; 32], true, &US, refund, &[]);
+    println!("crafted input vs other request's record: {r1:?}\npays another, names order: {r2:?}\ncollision: {r3:?}\nzero: {r4:?}\ntruncated: {r5:?}");
+    assert!(r1.is_err() && r2.is_err() && r4.is_err());
+    assert_eq!(r3, Ok(refund));
+}
