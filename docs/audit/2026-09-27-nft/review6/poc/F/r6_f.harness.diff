+// =====================================================================================================================================
+// Review round 6, part F (review6/poc/F): the PoCs. Each passing test shows the weakness is present.
+// =====================================================================================================================================
+
+/// hidden_deposit with the 4663 pin advancing at 10 blocks a second from now, the chain able to tell what used the nonce (`identify`)
+/// but its STATE kept only `depth` blocks back (None: archive).
+fn hidden_deposit_live(depth: Option<u64>) -> (Fake, EthState) {
+    let mut f = Fake::new(false);
+    f.live_pin = Some(f.now);
+    f.state_depth = depth;
+    f.identify = true;
+    let mut st = EthState::default();
+    hidden_deposit(&mut f, &mut st, E);
+    (f, st)
+}
+
+#[test]
+fn r6_f6_l1_at_the_runners_cadence_the_identification_is_out_of_the_providers_state_depth() {
+    // rpc.mainnet.chain.robinhood.com keeps ~6,200 blocks of state (review6/poc/F/depth_probe.output.txt: 6,100 back answers, 6,300
+    // back "historical state ... not available"); 4663 makes 10 blocks a second, so that is ~620 s. The runner ticks every
+    // RUNNER_TICK_EVERY_S (600 s default) AFTER each cycle ends (ops/src/runner.ts:192-195), and HomeTx.pin is the signing tick's
+    // START pin (EthNet's cached pin). A 60 s cycle puts the first resolving tick 660 s = 6,600 blocks after HomeTx.pin.
+    let (mut f, mut st) = hidden_deposit_live(Some(6_200));
+    let pin = st.pending.as_ref().unwrap().pin.unwrap();
+    let mut lines = Vec::new();
+    for _ in 0..(6 * 24) {
+        lines.extend(run_for(&mut f, &mut st, 1, 660));
+    }
+    assert!(lines.iter().any(|l| l.contains("historical state not available")), "identification fails on the state depth");
+    assert!(!lines.iter().any(|l| l.contains("nonce count")), "never identified, although the chain holds the transaction");
+    assert!(lines.iter().any(|l| l.contains("UNIDENTIFIED")), "every such deposit waits for the operator");
+    assert!(st.pending.is_some() && matches!(phase(&st), BPhase::Depositing { .. }), "the 4663 line (and the frog side's) halted a day");
+    println!("HomeTx.pin {pin}; the first resolving tick's pin {} ({} blocks on)", pin + 6_600, 6_600);
+}
+
+#[test]
+fn r6_f6_l1_control_at_a_60_s_cadence_or_on_an_archive_provider_it_is_identified() {
+    for (depth, step) in [(Some(6_200u64), 60u64), (None, 660)] {
+        let (mut f, mut st) = hidden_deposit_live(depth);
+        let l = run_for(&mut f, &mut st, 1, step).join("\n");
+        assert!(l.contains("MINED") && l.contains("nonce count"), "{l}");
+        assert!(matches!(phase(&st), BPhase::Bridging { .. }));
+    }
+}
