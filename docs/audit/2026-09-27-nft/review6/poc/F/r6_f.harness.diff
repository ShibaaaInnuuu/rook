+#[test]
+fn r6_f6_l2_one_provider_that_disagrees_on_the_receipt_halts_the_home_line_with_no_exit_and_no_unseen_page() {
+    // The likelier index failure is ONE provider missing the receipt (or answering it differently): evm_seen then returns Unsure
+    // (canister.rs:992-997), which resets used_since (ethflow.rs:3595-3600) and never runs the nonce identification (NotYet only).
+    // eth_home_clear needs used_since an hour old: refused for ever. The monitor's eth-home-unseen needs used_since too.
+    let (mut f, mut st) = hidden_deposit_live(None);
+    f.unsure = true;
+    let nonce = st.pending.as_ref().unwrap().nonce;
+    // a floor post falls due and waits behind the pending deposit
+    f.m(MODULE).posted_at = f.now;
+    let lines = run_for(&mut f, &mut st, 6 * 24, 600);
+    assert!(st.pending.as_ref().is_some_and(|p| p.used_since.is_none()), "never 'seen nowhere': the clock never starts");
+    assert!(ef::home_clear(&mut st, nonce, true, f.now).unwrap_err().contains("not yet seen nowhere"), "the operator's exit is refused");
+    assert!(!lines.iter().any(|l| l.contains("postFloor") || l.contains("mintDeposit") || l.contains("recordDelivery")),
+        "nothing else is signed on 4663 for a day");
+    assert!(!lines.iter().any(|l| l.contains("nonce count")), "the identification (which would succeed: identify = true, archive) never runs");
+    assert_eq!(relay_deposits(&f), 1);
+}
