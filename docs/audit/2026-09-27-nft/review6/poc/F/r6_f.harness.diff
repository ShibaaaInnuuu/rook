+#[test]
+fn r6_f6_i3_a_refused_mint_estimate_admits_every_waiting_deposit_of_the_collection_into_custody() {
+    // E5-L-1's fix: any send_home error of a deposit's mint is `own` (ethflow.rs:3419-3428), so step 3 goes on to the collection's next
+    // deposit, and each is admitted to the custody book (ethflow.rs:3406-3410) BEFORE its (failing) signature. A paused listing
+    // (ListingPaused) or the wrapper's own MintRateLimited refuses every one: all are admitted, none minted.
+    let mut f = Fake::new(true);
+    launch_limits(&mut f);
+    f.deposits_on = true;
+    f.finalized = ETH_PIN;
+    f.m(MODULE).accepted = 93 * E / 100;
+    let mut st = EthState::default();
+    f.mint_estimate_refuse = true;
+    let _ = milady_deposits(&mut f, &mut st, 4, 0x90);
+    let mut pending_admits = 0;
+    let mut lines = Vec::new();
+    for _ in 0..40 {
+        lines.extend(step(&mut f, &mut st, 600));
+    }
+    assert_eq!(st.deposits.iter().filter(|d| d.phase == ef::XPhase::Mint).count(), 4, "{:?}", st.deposits.iter().map(|d| d.phase.clone()).collect::<Vec<_>>());
+    assert!(lines.iter().any(|l| l.contains("ListingPaused")));
+    for d in &st.deposits {
+        let held = held_id(MILADY, 5_000 + d.tx[0] as u128);
+        if f.book.contains(&held) && d.phase == ef::XPhase::Mint {
+            pending_admits += 1;
+        }
+    }
+    let admitted: Vec<String> = f.book.entries.iter().map(|e| e.id.clone()).collect();
+    println!("custody book entries: {admitted:?}");
+    assert!(f.items.is_empty(), "nothing minted");
+    assert!(pending_admits >= 2, "more than the first waiting deposit holds custody room without a mint: {pending_admits}");
+}
