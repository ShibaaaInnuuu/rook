+#[test]
+fn r6_f6_i1_a_two_step_chain_move_keeps_the_old_chains_ethereum_floors() {
+    // F5-L-1's reset keys on saved_init.eth_nft → arg.eth_nft; an upgrade that DROPS eth_nft (allowed when nothing is open) and a later
+    // one that adds it on another chain both read `from` or `to` as None: chain_moved is false both times, and the old chain's floors
+    // (pin 26 M on Ethereum) refuse every pin of a chain whose head is lower, for good
+    let mut fl = etch_autobuyer::pin::PinFloors::default();
+    fl.eth.admit_pin("Ethereum", ETH_PIN).unwrap();
+    fl.eth.admit_nonce("Ethereum", 40).unwrap();
+    let mut st = EthState::default();
+    st.last_mined = Some((39, ETH_PIN - 5));
+    assert!(!ef::chain_moved(&mut st, &mut fl, Some(1), None), "drop: kept");
+    assert!(!ef::chain_moved(&mut st, &mut fl, None, Some(11_155_111)), "re-add on Sepolia: kept");
+    assert!(fl.eth.admit_pin("Ethereum", 9_300_000).is_err(), "every Sepolia pin is refused");
+    assert!(fl.eth.admit_nonce("Ethereum", 0).is_err(), "and every nonce");
+    assert!(st.last_mined.is_some());
+}
