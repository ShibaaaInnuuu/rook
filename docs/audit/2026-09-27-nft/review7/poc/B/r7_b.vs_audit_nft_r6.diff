+#[test]
+fn r7_b_l1_a_one_transient_deep_answer_in_the_hole_gives_up_the_rest_of_the_hole_for_good() {
+    // control: a 12,000-block gap (the runner down 40 h) on a deep pair: every sale in the gap is counted
+    let c = gap_with_sales(12_000, None, 144);
+    println!("control: gap sales {} of {}; newer {} of {}; lost {:?}; hole {:?}", c.0, c.1, c.2, c.3, c.4.lost, c.4.hole);
+    assert!(c.0 + 1 >= c.1);
+    // ONE answer with `deep` words from ONE of the two providers (a backend without the history, or a lying provider), once, on a
+    // read of the hole's lower part: the rest of the hole is recorded lost and never read again, for the whole week, although both
+    // providers serve it from the next read on
+    let r = gap_with_sales(12_000, Some((1_000, 3_000)), 144);
+    println!("one deep answer: gap sales {} of {} after TWO DAYS (every later read of both providers served); newer {} of {}; lost {:?}; hole {:?}", r.0, r.1, r.2, r.3,
+        r.4.lost, r.4.hole);
+    for l in r.5.iter().filter(|l| l.contains("NOT counted")).take(1) { println!("  note: {}", &l[..l.len().min(400)]); }
+    assert!(r.4.lost.is_some(), "recorded lost");
+    assert!(r.0 + 20 < r.1, "attack: the gap's older sales are never counted although served again: {} of {}", r.0, r.1);
+}
