+#[test]
+fn r7_b_l2_the_scan_lag_page_cannot_fire_the_reanchor_keeps_behind_under_a_day() {
+    // every log read of the Ethereum pair answered busy for three days (MEV Blocker's Cloudflare 1015 for the subnet's IPs, or one
+    // provider lying): no sale is counted; the monitor's eth-scan-behind pages at behind >= 7,200 (monitor/src/ethnft.mjs:18,150)
+    let mut f = Fake::new(false);
+    let mut st = EthState::default();
+    f.finalized = ETH_PIN;
+    f.pin_now = Some(ETH_PIN);
+    f.m(MODULE).accepted = 93 * E / 100;
+    for _ in 0..4 { quiet(&mut f, &mut st); }
+    let top0 = ETH_PIN - en::SALE_FINAL_DEPTH_BLOCKS;
+    let new = newer_sales(&mut f, top0 + 50, 100, 216, 0x5e);
+    let hs: Vec<[u8; 32]> = new.iter().map(|x| x.0).collect();
+    f.busy_pct = 100;
+    let (mut pin, mut max_behind, mut pages) = (ETH_PIN, 0u64, 0usize);
+    for i in 0..216u64 {
+        pin += 97 + (i * 7919) % 7; // 97..103 blocks a 20-minute pass (Ethereum's missed slots), not exactly 100
+        f.pin_now = Some(pin);
+        f.finalized = pin;
+        quiet(&mut f, &mut st);
+        let b = scan_of(&st).behind.unwrap_or(0);
+        max_behind = max_behind.max(b);
+        if b >= 7_200 { pages += 1; }
+    }
+    let sc = scan_of(&st);
+    println!("three days all busy: newer sales counted {} of {}; behind at most {max_behind} (the page needs 7,200): {pages} pass(es) would page; \
+        hole {:?} (SEV3, not persistent); lost {:?}", cached(&st, &hs), hs.len(), sc.hole, sc.lost);
+    assert_eq!(cached(&st, &hs), 0);
+    assert!(max_behind <= 7_200, "behind is at most SALE_REANCHOR_LAG_BLOCKS at a pass's end: the page's >= 7,200 holds only at equality");
+    assert!(pages * 100 <= 216, "attack: three days with no sale counted, and the lag page's condition held on {pages} of 216 passes (by chance)");
+}
