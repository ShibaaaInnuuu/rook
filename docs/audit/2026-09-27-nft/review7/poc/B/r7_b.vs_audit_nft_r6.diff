+    let old = newer_sales(&mut f, top0 - 30_000, 10, 16, 0x6b);
+    f.receipt_busy = old.iter().map(|x| x.0).collect();
+    for _ in 0..8 { quiet(&mut f, &mut st); }
+    let new = newer_sales(&mut f, top0 + 50, 100, 144, 0x5e);
+    let hs: Vec<[u8; 32]> = new.iter().map(|x| x.0).collect();
+    let mut pin = ETH_PIN;
+    for _ in 0..144 {
+        pin += 100;
+        f.pin_now = Some(pin);
+        f.finalized = pin;
+        quiet(&mut f, &mut st);
+    }
+    let top = pin - en::SALE_FINAL_DEPTH_BLOCKS;
+    let fin = new.iter().filter(|x| x.1 <= top).count();
+    let sc = scan_of(&st);
+    println!("16 old receipts answered busy: after two days {} of {} final newer sales read; rfail {:?}; behind {:?}; lost {:?}; hole {:?}",
+        cached(&st, &hs), fin, sc.rfail.map(|v| v.len()), sc.behind, sc.lost, sc.hole);
+    assert!(cached(&st, &hs) * 10 < fin, "attack: the newer sales wait behind the busy receipts: {} of {}", cached(&st, &hs), fin);
+    assert!(scan_of(&st).rfail.is_none(), "and nothing the monitor pages on is set");
 }
