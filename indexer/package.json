{
  "name": "etch-indexer",
  "private": true,
  "type": "module",
  "description": "Follows Etch's contracts' events into SQLite and serves a read-only HTTP API over them. It reads a chain; it has no signer and sends nothing.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --experimental-sqlite --no-warnings --import tsx src/main.ts",
    "test": "node --experimental-sqlite --no-warnings --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "fixtures": "node --experimental-sqlite --no-warnings --import tsx scripts/write-fixtures.ts",
    "fixtures:wrapped": "node --experimental-sqlite --no-warnings --import tsx scripts/write-wrapped-fixtures.ts",
    "fixtures:rook": "node --experimental-sqlite --no-warnings --import tsx src/rook/write-fixtures.ts",
    "fixtures:catalog": "node --experimental-sqlite --no-warnings --import tsx src/rook/write-catalog-fixtures.ts",
    "fixtures:v8": "node --experimental-sqlite --no-warnings --import tsx scripts/write-v8-fixtures.ts",
    "verify": "tsx scripts/rook-verify.ts",
    "verify:bundle": "node scripts/bundle-verify.mjs",
    "sol": "node --experimental-sqlite --no-warnings --import tsx src/sol/main.ts",
    "sol:dry-run": "node --experimental-sqlite --no-warnings --import tsx src/sol/main.ts --dry-run",
    "test:sol": "node --experimental-sqlite --no-warnings --import tsx --test test/sol_*.test.ts"
  },
  "dependencies": {
    "@icp-sdk/core": "6.1.0",
    "@noble/curves": "1.9.1",
    "tsx": "^4.19.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
