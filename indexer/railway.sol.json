{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "indexer/Dockerfile.sol", "watchPatterns": ["indexer/src/**", "indexer/package*.json", "indexer/Dockerfile.sol", "web-rook/src/config/solana.ts"] },
  "deploy": { "healthcheckPath": "/v1/health", "healthcheckTimeout": 60, "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 10, "numReplicas": 1 }
}
