# reconciler (K7, G5): ops/Dockerfile.reconciler, ops/railway.reconciler.json, CMD `node --import tsx src/reconcile.ts` (in /app/ops).
# Railway project: the MONITOR's (docs/deploy/services-v1.md §1). ONE replica. Volume at /data (last report + alert state).
# Read in ops/src/reconcile.ts parseReconcileConfig and monitor/src/alerts.mjs:52 (Telegram).
#
# KEYS AT A GLANCE (the books home): required ALERT_TELEGRAM_BOT_TOKEN (secret) + ALERT_TELEGRAM_CHAT_ID, SOL_RPC_URLS (two providers),
# CANISTER_ID (its queries ARE the books). Optional: RECONCILE_ETH_RPC_URLS (keyless defaults). No other key: inscriptions are located
# through ordinals.com + Ordinals Wallet (keyless). Run it once the canister is installed with its pins: before that it lists no
# collection and the report is UNVERIFIED (and pages).

# --- the home (docs/v9/canister-only-solana.md §10.2) -----------------------------------------------------------------------
# books (default: the canister-only Solana home) | robinhood (the 4663 stack reconciliation below, unchanged). The programs home
# (`solana`, rook_core's accounts) is retired with rook_core (decision D-l). Prefer ROOK_HOME to HOME (HOME is the Unix home directory).
ROOK_HOME=books
# REQUIRED on the books home: two independent https providers (decision D-h), every account must be byte-identical at each that answers
# (finalized). Helius keeps its key in the query: set the whole value sealed (scrubbed from logs).
SOL_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=<HELIUS_KEY>,https://solana-rpc.publicnode.com
# default: the image's /app/deployments/launch/canister-only/pins.json (the collections' names and symbols by index)
# RECONCILE_LAUNCH_FILE=/app/deployments/launch/canister-only/pins.json
# Ethereum RPCs for ownerOf of every held Ethereum NFT (all answering must agree). Default two keyless endpoints
# (ethereum-rpc.publicnode.com, eth.drpc.org); "" turns it off (those items are then UNVERIFIED, never green).
# RECONCILE_ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org
# Robinhood Chain RPCs for ownerOf of every held 4663 NFT (2026-10-12; a pinned chainId 4663 collection). Default two keyless endpoints;
# "" turns it off (those items are then UNVERIFIED, never green).
# RECONCILE_RH_RPC_URLS=

# --- the EVM home only (ROOK_HOME=robinhood) ------------------------------------------------------------------------------
RECONCILE_CHAIN_ID=4663
# the stack file baked into the image (COPY deployments): commit deployments/stack-4663.json before building. WRAPPED_CONFIG is an alias.
# Ordinals at launch: the mixed stack's ONE file names the Bitcoin module (bitcoin-frogs, kind inscriptions) beside the ten NFT ones, so
# its transit unit and custody are reconciled from the same file and the same custody_caps() read; nothing else to set.
RECONCILE_STACK=/app/deployments/stack-4663.json
# WRAPPED_CONFIG=
RECONCILE_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network
# the buyer: REQUIRED on the books home (books_view and the coin and desk queries are the books); on robinhood custody_caps() and, for the
# Ethereum collections, /v1/eth-records (the indexer's CANISTER_RECORDS_URL), and without it never green.
CANISTER_ID=<buyer canister id>
IC_HOST=https://icp-api.io
# SECRET. Required (refuses to start without both, E-08b)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=<the operator's chat id>
ALERT_TELEGRAM_API_BASE=https://api.telegram.org
RECONCILE_EVERY_S=3600
RECONCILE_STALE_S=10800
RECONCILE_REALERT_S=21600
RECONCILE_UNVERIFIED_ALERT_S=21600
RECONCILE_RUN_TIMEOUT_S=900
RECONCILE_MIN_BACKING_BPS=5000
RECONCILE_STALE_FLOOR_RED_S=3600
# a Relay advance out longer than this is red (default 48 h, reconcile.ts:136; docs/v6/relay-conversion.md §6)
RECONCILE_ADVANCE_STALE_S=172800
# set by the image
RECONCILE_STATE_DIR=/data
DATA_DIRS=/data
PORT=8080
# RECONCILE_PORT=                (fallback name for PORT)
RECONCILE_PUBLIC_URL=https://<reconciler Railway domain>
# OPENSEA_API_KEY=              (not used by the reconciler: only scrubbed from log lines if present, ops/src/log.ts:21; leave unset)
# ETH_LOGS_RPC=                 (not used by the reconciler: only scrubbed from log lines if present, ops/src/log.ts urlSecrets; leave unset)
# UNISAT_API_KEY=               (not used by the reconciler: only scrubbed from log lines if present; leave unset)
# RELAY_API_KEY=                (not used by the reconciler: only scrubbed from log lines if present; leave unset)
