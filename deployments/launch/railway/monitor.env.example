# monitor (K6): monitor/Dockerfile, monitor/railway.json, CMD `node monitor/src/main.mjs`. Railway project: its OWN (not the keeper's,
# not the runner's: docs/v6/k6-watcher-canary.md §7). ONE replica. Volume at /data (the config's "state": /data/monitor-state.json,
# plus the holder indexes beside it). Read in monitor/src/main.mjs, config.mjs, alerts.mjs:52, guardian.mjs:25, ethnft.mjs:489.

# The configuration: deployments/launch/monitor-nft.json, filled. The image does NOT contain deployments/, and the file names
# builds_file ../canister-ic.json, launch_file nft-pilot.json and evm.stack_file ../stack-4663.json RELATIVE to itself.
# Either (a) MONITOR_CONFIG_JSON = the filled file with those three inlined (node deployments/launch/railway/inline-monitor-config.mjs
# deployments/launch/monitor-nft.json prints it; the loader skips a *_file whose data is already inline, config.mjs:23-38), or
# (b) MONITOR_CONFIG = a path on the volume holding the same tree (e.g. /data/deployments/launch/monitor-nft.json with
# /data/deployments/canister-ic.json and stack-4663.json beside it). Set exactly one.
MONITOR_CONFIG_JSON=<output of inline-monitor-config.mjs>
# MONITOR_CONFIG=/data/deployments/launch/monitor-nft.json

# SECRET. Required (without both it refuses to start, unless --dry-run): the operator's Telegram bot
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=<the operator's chat id>
# default https://api.telegram.org
ALERT_TELEGRAM_API_BASE=https://api.telegram.org
# SECRET. Required because monitor-nft.json arms evm.guardian (D8 floor pause, pause_on_no_good_post_h 6): the guardian EOA's
# 32-byte hex key; its address must equal evm.guardian.address = registry.guardian() (guardian.mjs:25-32). Only this project holds it.
MONITOR_GUARDIAN_KEY=
# SECRET. Expanded into eth_nft.eth_rpc's ${DWELLIR_API_KEY} at load and redacted from every alert (config.mjs:73). Unset = refused.
DWELLIR_API_KEY=
# SECRET, optional: CoinGecko demo key for the D8 reference (ethnft.mjs:489); keyless without it
MONITOR_COINGECKO_KEY=
# status port (/healthz, /status). Default 8080 (main.mjs:171); Railway injects PORT
PORT=8080
# set by the image (drop-to-node chowns these to node)
DATA_DIRS=/data
