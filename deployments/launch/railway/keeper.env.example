# keeper (K3): keeper/Dockerfile, keeper/railway.json, start `node --import tsx service/main.ts` (the image's CMD).
# Railway project: the operator's keeper project (NOT the monitor's). ONE replica. Volume at /data.
# Full meaning of every variable: docs/deploy/services-v1.md §2. Read in keeper/service/config.ts parseServiceConfig (:122-244),
# keeper/service/signer.ts, keeper/src/opensea.ts, keeper/src/ordapi.ts, keeper/service/main.ts:26.
# For the NFT launch stack the keeper posts NO Ethereum floor (the canister posts each nft module's floor; keeper.ts:68): it posts the RAFFLE/BURN
# caps, announces/opens draws and runs the in-process keyless resolver. ORDINALS AT LAUNCH (the operator, 2026-10-09; nft-pilot.json
# `bitcoin`): the mixed stack's Bitcoin collection (bitcoin-frogs) is a classic module whose floor the KEEPER posts, from the Ordinals
# Wallet book (KEEPER_OW_SLUGS below; docs/v8/ordinals-wave.md §3.4): KEEPER_MODE=send with KEEPER_PRIVATE_KEY is needed for it.
# SECRET = sealed service variable set in Railway's UI. <...> = deploy-time value.

KEEPER_CHAIN_ID=4663
# the stack file baked into the image (keeper/Dockerfile COPY deployments): deployments/stack-4663.json must be committed before the build
KEEPER_STACK=/app/deployments/stack-4663.json
# dry-run first (go-live step 2), then send (docs/deploy/services-v1.md §5)
KEEPER_MODE=dry-run
# SECRET, send mode only. 32-byte hex; its address = registry.keeper() and every non-nft module's keeper(). Read only in service/signer.ts.
KEEPER_PRIVATE_KEY=
KEEPER_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network
KEEPER_INTERVAL_S=60
# /data is set by the image (keeper/Dockerfile ENV KEEPER_STATE_DIR=/data)
KEEPER_STATE_DIR=/data
PORT=8080
# KEEPER_STATUS_PORT=            (overrides PORT, config.ts:167)
# this service's public https URL (Railway domain); needed for draws
KEEPER_PUBLIC_URL=https://<keeper Railway domain>
# SECRET, optional (>= 32 chars): guards /status/full
KEEPER_STATUS_TOKEN=

# --- the snapshot mirror (draws on 4663 need one; docs/deploy/services-v1.md §2.2: the operator's R2 bucket) -----------------
KEEPER_SNAPSHOT_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
KEEPER_SNAPSHOT_S3_BUCKET=<the bucket>
KEEPER_SNAPSHOT_S3_PREFIX=rook-snapshots/
KEEPER_SNAPSHOT_S3_ACCESS_KEY_ID=<R2 API token access key id>
# SECRET
KEEPER_SNAPSHOT_S3_SECRET_ACCESS_KEY=
KEEPER_SNAPSHOT_S3_REGION=auto
KEEPER_SNAPSHOT_BASE_URL=https://pub-736187aaa62744868846472f72e8d77b.r2.dev/rook-snapshots
KEEPER_SNAPSHOT_UPLOAD_READBACK=on
# the plain-PUT mirror instead of R2 (one mirror only; leave unset with R2)
# KEEPER_SNAPSHOT_UPLOAD_URL=
# KEEPER_SNAPSHOT_UPLOAD_AUTH=    (SECRET)

# --- defaults (docs/deploy/services-v1.md §2 table) --------------------------------------------------------------------------
KEEPER_DRAND_URLS=https://api.drand.sh,https://drand.cloudflare.com,https://api2.drand.sh
# on: the in-process resolver; set off only if you prefer the standalone resolver alone (both on is safe: idempotent)
KEEPER_RESOLVER=on
KEEPER_RESOLVER_MAX_TX=10
KEEPER_RESOLVER_MAX_GAS_PER_TX=900000
KEEPER_MAX_GAS_PER_TX=400000
KEEPER_MAX_FEE_PER_GAS_WEI=1000000000
KEEPER_MAX_WEI_PER_TX=500000000000000
KEEPER_MAX_WEI_PER_DAY=10000000000000000
KEEPER_RECEIPT_WAIT_S=90
KEEPER_STUCK_AFTER_S=180
KEEPER_PASS_BUDGET_S=240
KEEPER_COINS_PER_PASS=200
KEEPER_ALERT_PASSES=3
KEEPER_ALERT_LATCH_S=1200
KEEPER_CAP_MARGIN_BPS=1000
KEEPER_RATE_MAX_DISAGREE_BPS=100
KEEPER_DRAW_EVERY_S=86400
KEEPER_DRAW_OFFSET_S=54000
KEEPER_DRAW_WINDOW_S=3000
# ordinals floor feed (frog / Bitcoin collections): the Bitcoin module's floor at launch (the lower median of the lowest 5 OW listings,
# one per seller cluster, >= 3 clusters: keeper/src/floor.ts; Frogs had 60 OW sellers on 2026-09-28)
KEEPER_FLOOR_SOURCE=ordinalswallet
# KEEPER_FLOOR_FIXTURE=          (tests only; refused for a send on 4663)
# <stack slug>=<Ordinals Wallet slug> (config.ts:218). LAUNCH VALUE: the stack slug is ETCH_STACK_SLUG=bitcoin-frogs (nft-pilot.json
# bitcoin.slug), the OW slug bitcoin.owSlug
KEEPER_OW_SLUGS=bitcoin-frogs=bitcoin-frogs
# SECRET, optional (keeper/src/ordapi.ts:156: the keyed UniSat reader of the ordinals feed); the floor itself is the OW book's. The
# canister's own UniSat key is separate (set_unisat_key, the operator's; runbook §9)
UNISAT_API_KEY=
# SECRET, optional: read by keeper/src/opensea.ts:127 for the ordinals/EVM floor sources; the NFT floors are the canister's (runner's key)
OPENSEA_API_KEY=
