# ===== THE LAUNCH SERVICE IS indexer-sol (docs/v9/indexer-solana.md §4, §6): config-as-code /indexer/railway.sol.json
# (indexer/Dockerfile.sol), volume /data, healthcheck /v1/health, ONE replica. Its variables first; the Robinhood-era indexer's
# variables below are kept for the stopped service only.
# SECRET (the key is in the URL): Helius, a key for the indexer only (decision O-13: Helius + PublicNode).
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<HELIUS_INDEXER_KEY>
# the failover: PublicNode (keyless)
SOLANA_RPC_URL_2=https://solana-rpc.publicnode.com
# SECRET, optional: the same Helius key, for DAS getTokenAccounts (exact holder counts)
HELIUS_API_KEY=
SOL_CLUSTER=mainnet-beta
SOL_DB_PATH=/data/rook-sol.db
# set by the image: /app/web-rook/src/config/solana.ts
# SITE_CONFIG_PATH=
# test/devnet override of the config list, never on the launch service
# ROOK_CONFIGS=
# DAY1_PLAN_PATH=
# the canister (deploy-time): its id, and its Solana keys K_main first (sol_address, then sol_address_of("claimer"), "treasury")
ROOK_CANISTER_ID=<the canister id from the ceremony>
ROOK_DESK_KEYS=<K_main>,<K_fc>,<K_tre>
IC_HOST=https://icp-api.io
# Helius Free: keep the indexer under its 1 M credits a month (docs/v9/indexer-solana.md §7): 10 s polls, holders every 30 min,
# 250 ms between calls. Move to the defaults (4000, 180, 0) on Helius Developer.
POLL_MS=10000
HOLDERS_EVERY_S=1800
RPC_MIN_GAP_MS=250
# defaults: BACKFILL_MAX_TX 20000, TX_CONCURRENCY 6, TX_CHUNK 100; SOL_DEBUG / DEBUG_RPC 1 for verbose logs (never on the launch service)
# BACKFILL_MAX_TX=
# TX_CONCURRENCY=
# TX_CHUNK=
# SOL_DEBUG=
# DEBUG_RPC=
#
# ===== the Robinhood-era indexer (stopped; docs/v9/robinhood-stop-2026-10-09.md)
# indexer + read-only API: indexer/Dockerfile (set RAILWAY_DOCKERFILE_PATH=indexer/Dockerfile; there is no railway.json),
# healthcheck /v1/health. No key anywhere. Volume at /data (SQLite). indexer/RAILWAY.md. Read in indexer/src/main.ts:45-107,
# src/v8/routes.ts:38, src/rook/catalogSources.ts:193.
RAILWAY_DOCKERFILE_PATH=indexer/Dockerfile
RPC_URL=https://rpc.mainnet.chain.robinhood.com
DB_PATH=/data/etch.db
DEPLOYMENTS_DIR=/app/deployments
CONFIRMATIONS=20
TRUST_PROXY=1
PORT=8787
# the stack file as the wrapped config (docs/v6/deploy-stack.md: a valid WRAPPED_CONFIG): the reserves page and the NFT ledger
WRAPPED_CONFIG=/app/deployments/stack-4663.json
# docs/v8 proof of reserves (the Ethereum side): a V8 config file, and the reconciler's /v1/eth-records. Unset = those routes are off.
# V8_CONFIG=
# CANISTER_RECORDS_URL=https://<reconciler Railway domain>/v1/eth-records
# defaults: POLL_MS 4000, CATALOG_TTL_S 600 (300..900), USD_POOL the built-in pool
# POLL_MS=4000
# CATALOG_TTL_S=600
# USD_POOL=
# local/test only, never on the launch service:
# DEPLOYMENT_FROM_RPC=1
# DEPLOYMENT_LABEL=test
# SECRET, optional: the catalog's OpenSea reads (catalogSources.ts:193)
OPENSEA_API_KEY=
