# fueler (docs/v7/cycles-from-fees.md §4.2, v1; the Solana home: docs/v9/fueler-solana.md): ops/Dockerfile.fueler, ops/railway.fueler.json,
# CMD `node --import tsx src/fueler.ts`.
# Railway project: the OPERATOR's (it holds keys), its OWN service, ONE replica, a volume at /data (the journal). Never the runner's
# service: it has its own keys and shares none. Every variable ops/src/fueler.ts parseFuelerConfig and ops/src/fuel/keys.ts read.
# SECRET = set in Railway's UI as a sealed service variable. <...> = a deploy-time value.
# A one-shot plan with nothing signed, from any machine:  node --import tsx src/fueler.ts --dry-run [--assume-cycles-t 34] [--assume-sol 0.6]

# --- home and mode ------------------------------------------------------------------------------------------------------------------
# books (the default; the canister-only Solana home, docs/v9/canister-only-solana.md §9.2): the ops share arrives as SOL at the Solana hot
# key, paid by the canister's own cranks to its treasury.ops (this hot key; set with treasury_set_ops) once 0.1 SOL is owed; SOL → ETH
# through Relay, then the Ethereum / IC legs below. robinhood: the original 4663 home (its variables are marked [robinhood] and not read
# on books). The programs home (`solana`, rook_core's `allocate`) is retired with rook_core (decision D-l): FUELER_SOL_PROGRAM must be unset.
FUEL_HOME=books
# dry (the default): reads everything, plans, logs what it would do, signs nothing. Run it dry for a day before `send`.
FUELER_MODE=dry

# --- keys (SECRET; read only in ops/src/fuel/keys.ts) --------------------------------------------------------------------------
# [books] the Solana hot key = the canister's treasury.ops (the operator runs treasury_set_ops(<its address>); a change waits a day). A FRESH keypair
# used for nothing else (`solana-keygen new --no-bip39-passphrase -o fueler-hot.json`). Set ONE of the two: the JSON itself as a sealed
# variable, or a path to the file (0600) on the /data volume. Fund it with about 0.05 SOL for its fees.
FUELER_SOL_KEYPAIR=
# NEVER set on the books home (the canister pays the hot key itself; fueler.ts refuses it): listed so the template names it
# FUELER_SOL_PROGRAM=
# FUELER_SOL_KEYPAIR_FILE=/data/fueler-hot.json
# A FRESH EOA, used for nothing else. [books] only its Ethereum address is used: Relay pays the bridged ETH there and it calls the ckETH
# helper (the deposit's gas comes out of the bridged ETH, so it needs no ETH of its own). [robinhood] it is `ops` (the Safe calls
# treasury.setOps(<its address>)), the same address on 4663 and Ethereum. 32-byte hex. Its address must have no code (EIP-7702 refused).
FUELER_EVM_KEY=
# A FRESH IC identity (`dfx identity new fueler`, then `dfx identity export fueler`), never the runner's OPERATOR_IDENTITY_PEM. It holds
# ckETH and ICP for minutes during a run, nothing between runs.
FUELER_IC_IDENTITY_PEM=
# Relay: /quote/v2 requires a key from 2026-10-02 (dashboard.relay.link). Without one the fueler warns and quotes may be refused.
RELAY_API_KEY=
RELAY_API_URL=https://api.relay.link

# --- what it serves ---------------------------------------------------------------------------------------------------------------
# the only canisters it tops up (and nothing else can be named); [books] the buyer's treasury_status names the ops key and the income mark
FUELER_BUYER=<buyer canister id>
FUELER_TIMELOCK=<timelock canister id>
# [books] the operator's COLD address: everything above FUELER_SOL_BUFFER + FUELER_SOL_DAY_MAX goes here. Default: the fund wallet
# GGgXnNgtY4ySfz8PLAAwkoh8Ztj7p6jrM9towSaa6Wuy (decision D-g). Never the hot key.
# FUELER_SOL_PAYEE=
# [books] two https providers at least (balances and accounts are read from every one; D-h: Helius free + PublicNode)
FUELER_RPC_SOL=https://mainnet.helius-rpc.com/?api-key=<key>,https://solana-rpc.publicnode.com
# [robinhood] ProtocolTreasury on 4663 (deployments/stack-4663.json "treasury")
# FUELER_TREASURY=<the treasury (stack-4663.json)>
# [robinhood] the operator's COLD address: every tick, everything above FUELER_BUFFER_ETH goes here. Not the treasury.
# FUELER_PAYEE=<the operator's cold address>
# [robinhood] the curves whose platform fees it claims (/v1/coins)
# FUELER_INDEXER_URL=https://<indexer host>
# [robinhood] two https providers
# FUELER_RPC_4663=https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network
# Ethereum (both homes: the ckETH helper deposit; receipts and balances are read from both)
FUELER_RPC_1=https://rpc.mevblocker.io,https://gateway.tenderly.co/public/mainnet
IC_HOST=https://icp-api.io

# --- when and how much (src/fuel/plan.ts DEFAULT_CAPS / DEFAULT_SOL_CAPS; the first month's small caps) ------------------------------
# the buyer is topped up when under LOW, toward TARGET (the dormant model: 34 T at the handover, ≈ 2.5 T a day per awake collection).
# The design's 100 T trigger (cycles-from-fees §3.1) is FUELER_BUYER_LOW_T=100 with a TARGET above it; the run and week caps still bound it.
FUELER_BUYER_LOW_T=40
FUELER_BUYER_TARGET_T=60
FUELER_TIMELOCK_LOW_T=1.5
FUELER_TIMELOCK_TARGET_T=2
# at most this per run and per 7 days (cycles); reaching the 7-day cap pages and stops until a human decides
FUELER_RUN_MAX_T=20
FUELER_WEEK_MAX_T=60
# at most one run in this many seconds (default 6 h)
FUELER_MIN_GAP_S=21600
# [books] at most this SOL converted per day and per 7 days; never below FLOOR (rent and fees); BUFFER kept for fees, and what is above
# BUFFER + DAY_MAX is forwarded to the payee (bounds a stolen key's take); no run under MIN_RUN; no forward under FORWARD_MIN
FUELER_SOL_DAY_MAX=1
FUELER_SOL_WEEK_MAX=2.5
FUELER_SOL_FLOOR=0.01
FUELER_SOL_BUFFER=0.05
FUELER_SOL_MIN_RUN=0.1
FUELER_SOL_FORWARD_MIN=0.01
# [books] Relay: the order's guaranteed minimum must be within this of the oracle's ETH for the SOL (S10; measured 2026-10-10: 1.0–1.3 %
# under at 0.1–0.26 SOL with Relay's slippage at 0.5 %); the slippage asked of Relay
FUELER_SOL_RELAY_MAX_FEE_BPS=200
FUELER_SOL_SLIPPAGE_BPS=50
# [books] the priority fee (micro-lamports per compute unit) and the compute-unit limit of each transaction (≈ 2,000 lamports extra)
FUELER_SOL_PRIORITY_MICROLAMPORTS=20000
FUELER_SOL_CU_LIMIT=100000
# [robinhood] at most this ETH converted per day and per 7 days (§3.2); floor, buffer, minimum run
# FUELER_DAY_MAX_ETH=0.10
# FUELER_WEEK_MAX_ETH=0.25
# FUELER_FLOOR_ETH=0.02
# FUELER_BUFFER_ETH=0.15
# FUELER_MIN_RUN_ETH=0.005
# [robinhood] claim a curve, or allocate the treasury, only once this much is owed
# FUELER_CLAIM_MIN_ETH=0.002
# FUELER_ALLOCATE_MIN_ETH=0.002
# an Ethereum gas price above this (gwei) waits (both homes: the helper deposit)
FUELER_ETH_MAX_FEE_GWEI=50
# page when a transaction has not mined (finalized on Solana) for this long, and when ckETH has not been minted for this long
FUELER_STUCK_S=7200
FUELER_MINT_STUCK_S=3600
# a dry run with no key: plan with these addresses (optional). FUELER_SOL_WATCH_ADDRESS: the hot key's SOL balance and the Relay quote's
# user; FUELER_WATCH_ADDRESS: the Ethereum recipient of the quote ([robinhood]: the 4663 balance)
# FUELER_SOL_WATCH_ADDRESS=
# FUELER_WATCH_ADDRESS=

# --- the operator's exits (read at start, then unset them and redeploy) ----------------------------------------------------------------
# clear a halt (SEV1 fueler-halt) once its cause is fixed
# FUELER_UNHALT=yes
# close an open run by its id (/status → run.id) once you have located its money; refused while one of its transactions is out
# FUELER_ABORT_RUN=

# --- the service ------------------------------------------------------------------------------------------------------------------
FUELER_EVERY_S=1800
# set by the image
FUELER_STATE_DIR=/data
DATA_DIRS=/data
PORT=8080
# FUELER_PORT=                   (fallback name for PORT)
# not read by the fueler, only scrubbed from its log lines if present (ops/src/log.ts envSecrets): leave unset
# OPENSEA_API_KEY=
# ETH_LOGS_RPC=
# ALERT_TELEGRAM_BOT_TOKEN=
