# standalone keyless resolver (fixes-W2-services.md §2; docs/deploy/services-v1.md §2.1): the KEEPER image (keeper/Dockerfile,
# keeper/railway.json) with the start command overridden to `node --import tsx service/resolver-main.ts`.
# Railway project: NOT the keeper's (the monitor's is the documented home). ONE replica. Its own volume at /data.
# It makes only calls anyone may make (Wrapper.resolve for pinned redemptions, SweepVault requestDraw/resolve/claim/voidDraw).
KEEPER_CHAIN_ID=4663
KEEPER_STACK=/app/deployments/stack-4663.json
KEEPER_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://rpc.ordofi.network
KEEPER_DRAND_URLS=https://api.drand.sh,https://drand.cloudflare.com,https://api2.drand.sh
# dry-run first, then send
RESOLVER_MODE=dry-run
# SECRET, send mode only: ANY funded 4663 account with no role; the registry's keeper key is refused (resolver-main.ts:34)
RESOLVER_PRIVATE_KEY=
# MUST be set: the default is ./resolver-state (config.ts:238), NOT the volume; the image only sets KEEPER_STATE_DIR=/data
RESOLVER_STATE_DIR=/data
# MUST be set for /healthz: the resolver reads only RESOLVER_STATUS_PORT, never PORT (config.ts:167), and keeper/railway.json's
# healthcheck (/healthz) fails the deploy without it. Use the port Railway routes (the image's PORT=8080).
RESOLVER_STATUS_PORT=8080
RESOLVER_INTERVAL_S=60
# the gas caps are read as for the keeper (config.ts:224-229)
KEEPER_MAX_GAS_PER_TX=400000
KEEPER_MAX_FEE_PER_GAS_WEI=1000000000
KEEPER_MAX_WEI_PER_TX=500000000000000
KEEPER_MAX_WEI_PER_DAY=10000000000000000
KEEPER_RESOLVER_MAX_TX=10
KEEPER_RESOLVER_MAX_GAS_PER_TX=900000
KEEPER_RECEIPT_WAIT_S=90
KEEPER_STUCK_AFTER_S=180
KEEPER_PASS_BUDGET_S=240
KEEPER_COINS_PER_PASS=200
KEEPER_ALERT_PASSES=3
KEEPER_ALERT_LATCH_S=1200
# SECRET, optional (>= 32 chars): guards /status/full
KEEPER_STATUS_TOKEN=
