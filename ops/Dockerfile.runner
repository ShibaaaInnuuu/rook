# K4: the operator runner (docs/v6/p1-services.md §2.1, docs/deploy/services-v1.md). It calls the canister's tick() as the operator.
# Build context: the REPO ROOT:   docker build -f ops/Dockerfile.runner .
# The image carries only the files the runner runs (runner, ic, identity, log, and the Relay and Ethereum NFT steps it imports: relay,
# ethnft): not the offer tool, not the reconciler. ops/test/guards.test.ts holds this list to runner.ts's imports.
# docs/v9/solana-migration.md §5 (the Solana home, ROOK_HOME=solana, the default): the Solana Relay judge (relaysol, fuel/sol's pure half),
# the Solana reader (solread), and the frog floor reading (solfloor), which runs the keeper's production feed unchanged
# (keeper/src/floor.ts, floorsources.ts, ordapi.ts and what they load), with the keeper's own dependencies; and the launch file (the
# Inscriptions listings and their Ordinals Wallet slugs).
# At run time: CANISTER_ID, and OPERATOR_IDENTITY_PEM (secret: `dfx identity export <the runner's identity>`, set in Railway's
# secret store, never in a command line or a file). No volume: every tick re-reads the canister, which keeps its own state.
# Audit E-16: no volume, so it simply runs as the image's `node` user.
FROM node:22-alpine
WORKDIR /app/ops
COPY ops/package.json ops/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY keeper/package.json keeper/package-lock.json /app/keeper/
RUN cd /app/keeper && npm ci --omit=dev --no-audit --no-fund
COPY ops/tsconfig.json ./
COPY ops/src/runner.ts ops/src/ic.ts ops/src/identity.ts ops/src/log.ts ops/src/relay.ts ops/src/ethnft.ts ops/src/owprotected.ts ops/src/unisatbuy.ts ops/src/frogmath.ts ops/src/relaysol.ts ops/src/solread.ts ops/src/solfloor.ts ops/src/solnftfloor.ts ops/src/inscriptions.ts src/
COPY ops/src/fuel/sol.ts src/fuel/
COPY keeper/tsconfig.json /app/keeper/
COPY keeper/src/floor.ts keeper/src/floorsources.ts keeper/src/ordapi.ts keeper/src/opensea.ts keeper/src/backoff.ts /app/keeper/src/
COPY deployments/launch/nft-pilot.json /app/deployments/launch/nft-pilot.json
# the Solana collections and their Magic Eden symbols (RUNNER_SOL_NFT_FLOOR, src/solnftfloor.ts)
COPY deployments/launch/solana-collections.json /app/deployments/launch/solana-collections.json
# every Inscriptions collection's members (deployments/launch/btc/README.md), the launch file's membersFile: the proof step proves a holder
# deposit from its LIVE collection's file, and RUNNER_INSCRIPTIONS names them for the buying steps (docs/v8/ow-protected.md §4); a file is
# read only when its collection is live in the canister (or named), and checked against the canister's root first
COPY deployments/launch/btc/*-members.json /app/deployments/launch/btc/
ENV NODE_ENV=production PORT=8080
USER node
EXPOSE 8080
HEALTHCHECK --interval=120s --timeout=5s --start-period=60s CMD wget -qO- "http://127.0.0.1:${PORT:-8080}/healthz" >/dev/null || exit 1
CMD ["node", "--import", "tsx", "src/runner.ts"]
